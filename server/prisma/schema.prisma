generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DevicePlatform {
  android
  ios
  windows
  macos
  linux
}

enum ConversationType {
  direct
  group
}

enum ParticipantRole {
  member
  admin
}

enum ReceiptEventType {
  delivered
  read
}

enum PushPlatform {
  fcm
  apns
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  displayName  String    @map("display_name")
  passwordHash String?   @map("password_hash")
  // Second facteur TOTP. Le secret n'est jamais renvoyé par l'API après
  // l'enrôlement. totpEnabledAt distingue « secret généré, en attente de
  // confirmation » de « 2FA réellement active » : tant qu'un premier code
  // valide n'a pas été fourni, le second facteur n'est pas exigé.
  totpSecret    String?   @map("totp_secret")
  totpEnabledAt DateTime? @map("totp_enabled_at")
  // Rôle. « admin » n'ouvre AUCUN accès aux messages : les routes
  // d'administration ne touchent que des métadonnées, et rien dans le serveur
  // ne peut déchiffrer quoi que ce soit — les clés n'y sont jamais passées.
  role UserRole @default(user)

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Jeton de réinitialisation émis par un administrateur, à la demande de
  // l'utilisateur. Stocké HACHÉ : l'administrateur le transmet une fois et le
  // serveur ne peut pas le retrouver ensuite.
  resetTokenHash String?   @map("reset_token_hash")
  resetExpiresAt DateTime? @map("reset_expires_at")

  devices              Device[]
  webauthnCredentials  WebauthnCredential[]
  createdConversations Conversation[]            @relation("ConversationCreator")
  participants         ConversationParticipant[]
  authSessions         AuthSession[]

  avatars AttachmentRef[] @relation("AvatarOwner")

  blocksMade     Block[] @relation("Blocker")
  blocksReceived Block[] @relation("Blocked")

  @@map("users")
}

model WebauthnCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  credentialId Bytes    @unique @map("credential_id")
  publicKey    Bytes    @map("public_key")
  signCount    BigInt   @default(0) @map("sign_count")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("webauthn_credentials")
}

model Device {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  deviceName        String   @map("device_name")
  platform          DevicePlatform
  identityPublicKey Bytes    @map("identity_public_key")
  isActive          Boolean  @default(true) @map("is_active")

  // Jeton de remise pour l'expéditeur scellé.
  //
  // Stocké HACHÉ : le serveur doit pouvoir reconnaître un jeton présenté, pas
  // le retrouver ni le distribuer. Sa valeur en clair ne circule que dans le
  // canal chiffré, vers les correspondants avec qui une session existe déjà.
  //
  // C'est ce jeton qui remplace l'authentification au dépôt : celui qui le
  // détient peut déposer un blob pour cet appareil SANS dire qui il est. Le
  // serveur perd ainsi la moitié du graphe social qu'il observait.
  deliveryTokenHash String? @map("delivery_token_hash")
  createdAt         DateTime @default(now()) @map("created_at")
  lastSeenAt        DateTime @default(now()) @map("last_seen_at")

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  signedPrekeys      SignedPrekey[]
  oneTimePrekeys     OneTimePrekey[]
  signaturesGiven    DeviceSignature[] @relation("Signer")
  signaturesReceived DeviceSignature[] @relation("Signed")
  pushTokens         PushToken[]
  authSessions       AuthSession[]
  sentBlobs          MessageBlob[]     @relation("SentBlobs")
  receivedBlobs      MessageBlob[]     @relation("ReceivedBlobs")

  @@map("devices")
}

model SignedPrekey {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @map("device_id") @db.Uuid
  publicKey Bytes    @map("public_key")
  signature Bytes
  isCurrent Boolean  @default(true) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("signed_prekeys")
}

model OneTimePrekey {
  id         String    @id @default(uuid()) @db.Uuid
  deviceId   String    @map("device_id") @db.Uuid
  publicKey  Bytes     @map("public_key")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("one_time_prekeys")
}

model DeviceSignature {
  id             String   @id @default(uuid()) @db.Uuid
  signerDeviceId String   @map("signer_device_id") @db.Uuid
  signedDeviceId String   @map("signed_device_id") @db.Uuid
  signature      Bytes
  createdAt      DateTime @default(now()) @map("created_at")

  signer Device @relation("Signer", fields: [signerDeviceId], references: [id], onDelete: Cascade)
  signed Device @relation("Signed", fields: [signedDeviceId], references: [id], onDelete: Cascade)

  @@unique([signerDeviceId, signedDeviceId])
  @@map("device_signatures")
}

model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  type      ConversationType
  // Nullable : quand le créateur supprime son compte, la conversation doit
  // survivre pour les autres participants — leur historique ne lui appartient
  // pas. Le champ passe à NULL au lieu de bloquer la suppression.
  createdBy String?          @map("created_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")

  creator      User?                     @relation("ConversationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messageBlobs MessageBlob[]
  attachments  AttachmentRef[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String          @map("conversation_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  role           ParticipantRole @default(member)
  joinedAt       DateTime        @default(now()) @map("joined_at")
  leftAt         DateTime?       @map("left_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

model MessageBlob {
  id String @id @default(uuid()) @db.Uuid

  // Tous deux NULLABLES depuis l'expéditeur scellé : un blob déposé avec un
  // jeton de remise ne dit ni qui l'envoie, ni dans quelle conversation. Ces
  // deux champs étaient précisément ce que le serveur observait du graphe
  // social — les garder obligatoires aurait vidé le scellement de son sens.
  conversationId String? @map("conversation_id") @db.Uuid
  senderDeviceId String? @map("sender_device_id") @db.Uuid
  recipientDeviceId String    @map("recipient_device_id") @db.Uuid
  clientMessageId   String    @map("client_message_id") @db.Uuid
  ratchetHeader     Bytes     @map("ratchet_header")
  ciphertext        Bytes
  createdAt         DateTime  @default(now()) @map("created_at")
  deliveredAt       DateTime? @map("delivered_at")
  expiresAt         DateTime  @map("expires_at")

  conversation Conversation?   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Cascade des deux côtés : un blob non remis à un appareil supprimé est
  // indéchiffrable de toute façon (ses clés privées ont disparu avec lui). Le
  // conserver bloquerait la suppression de compte et garderait du chiffré sans
  // titulaire — l'inverse de la minimisation des données.
  sender       Device?         @relation("SentBlobs", fields: [senderDeviceId], references: [id], onDelete: Cascade)
  recipient    Device          @relation("ReceivedBlobs", fields: [recipientDeviceId], references: [id], onDelete: Cascade)
  receipts     MessageReceipt[]

  @@unique([recipientDeviceId, clientMessageId])
  @@map("message_blobs")
}

model MessageReceipt {
  messageBlobId String           @map("message_blob_id") @db.Uuid
  eventType     ReceiptEventType @map("event_type")
  occurredAt    DateTime         @default(now()) @map("occurred_at")

  messageBlob MessageBlob @relation(fields: [messageBlobId], references: [id], onDelete: Cascade)

  @@id([messageBlobId, eventType])
  @@map("message_receipts")
}

model AttachmentRef {
  id String @id @default(uuid()) @db.Uuid

  // Nullable depuis l'arrivée des photos de profil : un avatar n'appartient à
  // aucune conversation. Laisser ce champ obligatoire aurait imposé de rattacher
  // la photo à une conversation arbitraire, qui l'aurait emportée en
  // disparaissant et l'aurait fait expirer au bout de trente jours.
  conversationId String? @map("conversation_id") @db.Uuid

  // Renseigné à la place, pour les pièces jointes de profil. Le compte supprimé,
  // sa photo l'est aussi.
  ownerUserId String? @map("owner_user_id") @db.Uuid

  uploaderDeviceId  String    @map("uploader_device_id") @db.Uuid
  storageKey        String    @map("storage_key")
  encryptedMetadata Bytes     @map("encrypted_metadata")
  ciphertextSize    BigInt    @map("ciphertext_size")
  createdAt         DateTime  @default(now()) @map("created_at")
  expiresAt         DateTime? @map("expires_at")

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  owner        User?         @relation("AvatarOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@map("attachment_refs")
}

model PushToken {
  id        String       @id @default(uuid()) @db.Uuid
  deviceId  String       @map("device_id") @db.Uuid
  platform  PushPlatform
  token     String
  updatedAt DateTime     @default(now()) @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, platform])
  @@map("push_tokens")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  deviceId         String    @map("device_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

/**
 * Blocage d'un compte par un autre.
 *
 * Appliqué CÔTÉ SERVEUR, pas seulement à l'affichage : un blocage repose
 * uniquement dans l'application laisserait la personne bloquée déposer des
 * blobs, consommer du stockage et voir ses messages « remis ». Le serveur ne
 * peut pas lire ces messages, mais il sait qui écrit à qui — c'est
 * précisément ce qu'il faut pour les refuser.
 */
model Block {
  blockerUserId String   @map("blocker_user_id") @db.Uuid
  blockedUserId String   @map("blocked_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@id([blockerUserId, blockedUserId])
  @@index([blockedUserId])
  @@map("blocks")
}

enum UserRole {
  user
  admin
}

/**
 * Journal des actions d'administration.
 *
 * Distinct d'AuditLog : celui-ci n'est jamais purgé et ne peut être ni modifié
 * ni supprimé par l'API. Un pouvoir sans trace n'est pas un pouvoir encadré —
 * c'est ce registre qui rend une suppression de compte contestable après coup.
 */
model AdminAction {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  // Cible conservée en clair (nom d'utilisateur) : après suppression du compte,
  // l'identifiant ne renvoie plus à rien et la trace deviendrait illisible.
  targetLabel String?  @map("target_label")
  targetId    String?  @map("target_id") @db.Uuid
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admin_actions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  deviceId  String?  @map("device_id") @db.Uuid
  eventType String   @map("event_type")
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}
