DATABASE_URL=postgresql://ziacrypte:changeme@localhost:5432/ziacrypte
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
PORT=3210
S3_ENDPOINT=https://storage.exemple.fr
S3_REGION=us-east-1
S3_BUCKET=ziacrypte-attachments
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
# Style d'URL : « true » pour MinIO derrière un proxy et pour Cloudflare R2,
# « false » pour les hébergeurs qui n'acceptent que <bucket>.<hôte>.
S3_FORCE_PATH_STYLE=true
# Bascule vers un stockage externe : voir docs/stockage-externe.md
# (R2 attend S3_REGION=auto)
